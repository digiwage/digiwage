QToolButton { background: transparent; color: @text-2@; border: none; border-radius: @radius-s@px; padding: 9px 12px; margin: 1px 0px; font-size: @font-body@px; font-weight: 500; text-align: left; }
QToolButton:hover:!checked { background-color: @hover@; color: @text@; }
QToolButton:pressed { background-color: @pressed@; }
QToolButton:checked { background-color: @accent-soft@; color: @text@; }
QToolButton[collapsed="true"] { padding: 9px 0px; }
