QToolButton { background: transparent; color: @text-2@; border: none; border-radius: 6px; padding: 7px 14px 7px 38px; margin: 1px 0px; font-size: @font-label@px; font-weight: 500; text-align: left; }
QToolButton:hover:!checked { background-color: @hover@; color: @text@; }
QToolButton:pressed { background-color: @pressed@; }
QToolButton:checked { color: @accent-text@; background-color: transparent; }
